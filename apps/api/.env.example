# Acube server — copy to .env and fill in real values. Never commit a real .env.
# Server env vars (14). Client vars live in client/.env.example.

# MongoDB connection string
DB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT signing secret.
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth client ID (from Google Cloud Console). Required for login:
# POST /user/login verifies the Google ID token server-side against this
# client ID. There is no bypass — without a real value here (Arman must
# supply it from Google Cloud Console), Google login returns 401.
# The same client ID is the web client's VITE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Port the API listens on
PORT=5000

# Public frontend origin (used for CORS allowlist from Phase 1)
FRONTEND_URL=http://localhost:3000

# Cloudinary (video/image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe secret key (server-side only)
STRIPE_SK=sk_test_...

# Stripe webhook signing secret (from the Stripe Dashboard → Developers →
# Webhooks → your endpoint's "Signing secret"). Required for
# POST /download/webhook: without it the webhook answers 500 and premium
# is never granted by webhook. Arman must supply the real value.
STRIPE_WEBHOOK_SECRET=whsec_...

# Premium price in INR (server-side catalogue — the client never sends an
# amount). Default 1000. Change here if the price changes; do NOT put a
# price in client code.
PREMIUM_PRICE_INR=1000

# Chat message encryption key (shared server-side key; NOT true E2E — see PHASE1_REPORT.md)
SECRETKEY_CRYPTO=change-me-to-a-long-random-secret

# Twilio (SMS OTP)
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACCOUNT_TOKEN=your-twilio-auth-token
TWILIO_NUMBER=+10000000000

# Gmail SMTP for OTP emails (use an app password, never your real password)
STP_USER=you@example.com
STP_PASSWORD=your-gmail-app-password
