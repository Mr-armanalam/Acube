# Acube client (Vite) — copy to .env and fill in real values. Never commit a real .env.
# These VITE_* vars are bundled into the JS sent to the browser, so they
# are NOT secrets. Do not put server secrets here.

# API base URL (server, e.g. http://localhost:5000)
VITE_BACKEND_URL=http://localhost:5000

# Google OAuth client ID (from Google Cloud Console)
VITE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Client-side AES key used for encrypting room ids in URLs (obfuscation only,
# not security — the key ships in the bundle)
VITE_ENCRYPTED_KEY=change-me
